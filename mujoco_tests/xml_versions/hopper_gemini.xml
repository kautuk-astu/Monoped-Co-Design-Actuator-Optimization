<?xml version="1.0"?>
<mujoco model="hopper">
  <compiler angle="radian" inertiafromgeom="auto" />
  <option timestep="0.01" />
  <default>
    <geom contype="1" conaffinity="1" rgba="0.8 0.1 0.1 1"/>
  </default>
  <worldbody>
    <light pos="0 0 5" dir="0 0 -1"/>
    <geom name="floor" type="plane" size="10 10 10" rgba="0.8 0.8 0.8 1"/>
    <body name="torso" pos="0 0 0.25">
      <inertial pos="0 0 0" mass="1" diaginertia="0.01 0.01 0.01"/>
      <geom type="box" size="0.1 0.1 0.25"/>
      <joint name="hip" type="hinge" pos="0 0 0" axis="0 1 0"/>
      <body name="thigh">
        <inertial pos="0 0 -0.25" mass="1" diaginertia="0.01 0.01 0.01"/>
        <geom type="box" size="0.1 0.1 0.5"/>
        <joint name="knee" type="hinge" pos="0 0 -0.5" axis="0 1 0"/>
        <body name="leg">
          <inertial pos="0 0 -0.25" mass="1" diaginertia="0.01 0.01 0.01"/>
          <geom type="box" size="0.1 0.1 0.5"/>
        </body>
      </body>
    </body>
  </worldbody>
  <actuator>
    <motor ctrllimited="true" ctrlrange="-1 1" gear="100" joint="hip"/>
    <motor ctrllimited="true" ctrlrange="-1 1" gear="100" joint="knee"/>
  </actuator>
</mujoco>