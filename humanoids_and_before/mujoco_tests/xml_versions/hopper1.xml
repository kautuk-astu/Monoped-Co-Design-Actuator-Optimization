<mujoco model="hopper">
  <worldbody>
    <geom name="floor" size="20 20 .125" type="plane"/>
    <body name="torso" pos="0 0 0">
      <joint name="rootx" type="slide" axis="1 0 0"/>
      <joint name="rootz" type="slide" axis="0 0 1"/>
      <joint name="rooty" type="hinge" axis="0 1 0"/>
      <geom name="torso_geom" type="capsule" size="0.05" fromto="0 0 1.45 0 0 1.05"/>
    </body>
  </worldbody>
  <actuator>
    <motor joint="rootx" ctrlrange="-1.0 1.0"/>
  </actuator>
</mujoco>