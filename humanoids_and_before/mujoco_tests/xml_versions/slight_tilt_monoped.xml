<mujoco model="slight_tilt_monoped">
    <compiler angle="degree" meshdir="meshes" eulerseq="xyz"  />
    <default>
        <joint armature="1" damping="1" limited="true"/>
        <geom conaffinity="1" condim="1" contype="1" margin="0.001" material="geom" rgba="0.8 0.6 .4 1" solimp=".8 .8 .01" solref=".02 1"/>
        <motor ctrllimited="true" ctrlrange="-1000 1000"/>
    </default>
    <option gravity = "0 0 -9.81" integrator="RK4" timestep="0.002"/>
    <visual>
        <map znear="0.02"/>
    </visual>
    <worldbody>
        <light cutoff="100" diffuse="1 1 1" dir="-0 0 -1.3" directional="true" exponent="1" pos="0 0 1.3" specular=".1 .1 .1"/>
        <geom conaffinity="1" condim="3" name="floor" pos="0 0 0" rgba="0.8 0.9 0.8 1" size="20 20 .125" type="plane" material="MatPlane"/>
        <body name = "slot" pos="0 0 0">
            <geom friction="0.9"  name="slot_geom" size = "1 0.1 0.05" type="box"/>
            <body name="torso" pos="0 0 0.997">                        
                <camera name="track" mode="trackcom" pos="0 -3 1" xyaxes="1 0 0 0 0 1"/>
                <joint armature="0" axis="0 0 1" damping="0" limited="false" name="rootz" pos="0 0 0" stiffness="0" type="slide"/>
                <geom friction="0.9" fromto="-0.20 0 0 0.20 0 0.0" name="torso_geom" size="0.05" type="capsule" rgba="0 0 0 0.5"/>
                <body name="thigh" pos="0.022 0 -0.249" euler="0 0 0">
                    <joint axis="0 -1 0" name="thigh_joint" pos="-0.022 0 0.249" range="-180 180" type="hinge"/>
                    <geom friction="0.9" fromto="0.017 0 -0.199 -0.017 0 0.199" name="thigh_geom" size="0.05" type="capsule" rgba="0.8 0.6 .4 1"/>
                    <body name = "leg" pos="0 0 -0.448" euler="0 0 0">                        
                        <joint axis="0 -1 0" name="leg_joint" pos="0.022 0 0.249" range="-180 180" type="hinge"/>
                        <geom friction="0.9" fromto="-0.017 0 -0.199 0.017 0 0.199" name="leg_geom" size="0.05" type="capsule" rgba="0.8 0.6 .4 1"/>1
                    </body>
                </body>           

                       

            </body>    
    
        </body>
    </worldbody>
    <asset>
        <texture type="skybox" builtin="gradient" rgb1=".4 .5 .6" rgb2="0 0 0"
            width="100" height="100"/>
        <texture builtin="flat" height="1278" mark="cross" markrgb="1 1 1" name="texgeom" random="0.01" rgb1="0.8 0.6 0.4" rgb2="0.8 0.6 0.4" type="cube" width="127"/>
        <texture builtin="checker" height="100" name="texplane" rgb1="0 0 0" rgb2="0.8 0.8 0.8" type="2d" width="100"/>
        <material name="MatPlane" reflectance="0.5" shininess="1" specular="1" texrepeat="60 60" texture="texplane"/>
        <material name="geom" texture="texgeom" texuniform="true"/>
    </asset>
    <actuator>
        <position name="rootz" kp="0" joint="rootz" />
        <motor name="thigh_joint" gear="1" joint="thigh_joint" ctrllimited="true" ctrlrange="-10000 10000" forcelimited="true" forcerange="-6 6"/>
        <motor name="leg_joint" gear="1" joint="leg_joint" ctrllimited="true" ctrlrange="-10000 10000" forcelimited="true" forcerange="-6 6"/>
    </actuator>
</mujoco>