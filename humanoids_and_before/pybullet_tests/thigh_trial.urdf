<?xml version="1.0"?> <!--All distances in m-->
<robot name="single_legged_robot">

  <link name="floor">
    <inertial>
      <mass value="0"/> <!-- Static body with zero mass -->
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <plane normal="0 0 1"/> <!-- Infinite plane with normal in z-direction -->
      </geometry>
    </collision>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <plane normal="0 0 1"/>
      </geometry>
    </visual>
  </link>


  <!-- Base (top part of the robot) -->
  <link name="base_link">
    <visual>
      <origin xyz="0.05 0.05 0.025" rpy="0 0 0"/>
      <geometry>
        <box size="0.10 0.10 0.05"/> <!-- A box-shaped base -->
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0.05 0.05 0.025" rpy="0 0 0"/>
      <geometry>
        <box size="0.10 0.10 0.05"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.05 0.05 0.025" rpy="0 0 0"/>  <!--WRT the link origin-->
      <mass value="0.8"/> <!--kg-->
      <inertia ixx="0.0008333" ixy="0.0" ixz="0.0" iyy="0.0008333" iyz="0.0" izz="0.0000011"/>
    </inertial>
  </link>

  <link name="thigh_link">
    <visual>
      <origin xyz="0 0 -0.1" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.2" radius="0.025"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.1" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.05 0.2"/>  <!--modified from cylinder shape-->
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 -0.1" rpy="0 0 0"/>
      <mass value="0.08"/>  <!--taken from Pramod's xml-->
      <inertia ixx="0.0000005" ixy="0.0" ixz="0.0" iyy="0.0000005" iyz="0.0" izz="0.000025"/>
    </inertial>
  </link>

  
  <joint name="prismatic_joint" type="prismatic">
    <parent link="floor"/> <!-- The robot's base is attached to the world -->
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/> <!-- Movement along Z-axis (up-down) -->
    <limit lower="0.0" upper="2.0"/> <!-- Limits for the jumping action -->
  </joint>

  
  <joint name="hip_joint" type="revolute">
    <parent link="base_link"/>
    <child link="thigh_link"/>
    <origin xyz="0.05 0.05 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.57" upper="1.57" effort="10.0" velocity="1.0"/>
  </joint>



</robot>