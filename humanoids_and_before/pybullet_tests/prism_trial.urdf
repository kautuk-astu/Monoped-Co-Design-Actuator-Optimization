<?xml version="1.0"?>
<robot name="single_legged_robot">

  <!-- Base (top part of the robot) -->
  <link name="base_link">
    <visual>
      <origin xyz="0 -0.108 0.054" rpy="0 0 3.14"/>
      <geometry>
        <box size="0 -0.216 0.108"/> <!-- A box-shaped base -->
      </geometry>
      <!--material name="grey"/-->
    </visual>
    <collision>
      <!--origin xyz="0 0 0" rpy="0 0 0"/-->
      <origin xyz="0 -0.108 0.054" rpy="0 0 3.14"/>
      <geometry>
        <!--box size="0.3 0.3 0.1"/-->
        <box size="0 -0.216 0.108"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 -0.108 0.054" rpy="0 0 3.14"/>  <!--WRT the link origin-->
      <mass value="0.8"/>
      <inertia ixx="0.00035155" ixy="0.0" ixz="0.0" iyy="0.0016709" iyz="0.0" izz="0.0013474"/>
    </inertial>
  </link>

  <!-- Thigh link -->
  <link name="thigh_link">
    <visual>
      <origin xyz="0 0 -0.3" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.6" radius="0.05"/> <!-- Cylindrical thigh link -->
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.3" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.6" radius="0.05"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 -0.3" rpy="0 0 0"/>
      <mass value="1.5"/>
      <inertia ixx="0.08" ixy="0.0" ixz="0.0" iyy="0.08" iyz="0.0" izz="0.01"/>
    </inertial>
  </link>

  <!-- Calf link -->
  <link name="calf_link">
    <visual>
      <origin xyz="0 0 -0.3" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.6" radius="0.04"/> <!-- Cylindrical calf link -->
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.3" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.6" radius="0.04"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 -0.3" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.07" ixy="0.0" ixz="0.0" iyy="0.07" iyz="0.0" izz="0.01"/>
    </inertial>
  </link>

  <!-- Prismatic joint (jumps up and down along Z-axis) -->
  <joint name="prismatic_joint" type="prismatic">
    <parent link="world"/> <!-- The robot's base is attached to the world -->
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/> <!-- Movement along Z-axis (up-down) -->
    <limit lower="0.0" upper="2.0" effort="200.0" velocity="2.0"/> <!-- Limits for the jumping action -->
  </joint>

  <!-- Hip joint -->
  <joint name="hip_joint" type="fixed">
    <parent link="base_link"/>
    <child link="thigh_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Knee joint -->
  <joint name="knee_joint" type="fixed">
    <parent link="thigh_link"/>
    <child link="calf_link"/>
    <origin xyz="0 0 -0.6" rpy="0 0 0"/>
  </joint>

</robot>
